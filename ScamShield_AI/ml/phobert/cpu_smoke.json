{
  "checkpoint": "artifacts/phobert/base",
  "segmenter": "artifacts/phobert/vncorenlp",
  "train": "../data/phobert/splits/train.jsonl",
  "validation": "../data/phobert/splits/validation.jsonl",
  "output": "artifacts/phobert/smoke_heads",
  "seed": 17,
  "device": "cpu",
  "threads": 2,
  "freeze_encoder": true,
  "learning_rate": 0.003,
  "encoder_learning_rate": 0.00002,
  "batch_size": 1,
  "gradient_accumulation": 2,
  "max_length": 256,
  "overlap": 24,
  "max_span_words": 12,
  "epochs": 40,
  "early_stopping": 8,
  "span_positive_weight": 12.0,
  "span_threshold": 0.5,
  "relation_threshold": 0.5,
  "stages": ["spans", "attributes", "roles", "relations", "baseline"],
  "loss_weights": {"spans": 1.0, "attributes": 1.0, "roles": 1.0, "relations": 1.0, "baseline": 1.0},
  "allow_draft_smoke": true
}
