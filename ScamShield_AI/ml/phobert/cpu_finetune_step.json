{
  "checkpoint": "artifacts/phobert/base",
  "segmenter": "artifacts/phobert/vncorenlp",
  "train": "../data/phobert/splits/train.jsonl",
  "validation": "../data/phobert/splits/validation.jsonl",
  "output": "artifacts/phobert/finetune_step",
  "seed": 17,
  "device": "cpu",
  "threads": 2,
  "freeze_encoder": false,
  "learning_rate": 0.0001,
  "encoder_learning_rate": 0.00002,
  "batch_size": 1,
  "gradient_accumulation": 2,
  "max_length": 128,
  "overlap": 24,
  "max_span_words": 12,
  "epochs": 1,
  "early_stopping": 1,
  "train_sample_limit": 2,
  "span_positive_weight": 12.0,
  "span_threshold": 0.5,
  "relation_threshold": 0.5,
  "stages": ["spans"],
  "loss_weights": {"spans": 1.0},
  "allow_draft_smoke": true
}
