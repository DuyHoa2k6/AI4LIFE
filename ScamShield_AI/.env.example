# Local backend; no model, endpoint or API key required.
SCAMSHIELD_MODE=local_rules
SCAMSHIELD_REASONER=legacy
SCAMSHIELD_CONTEXT_ENABLED=1
SCAMSHIELD_SEMANTIC_GRAPH_ENABLED=1
SCAMSHIELD_TIMEOUT=20
SCAMSHIELD_DISABLE_RESPONSE_TIMEOUTS=1
SCAMSHIELD_ALLOWED_ORIGINS=http://localhost:5173
SCAMSHIELD_RAG_ENABLED=1
SCAMSHIELD_URL_NETWORK_ENABLED=1
SCAMSHIELD_RETRIEVAL_TIMEOUT=0.8
