{
  "manifest_version": 3,
  "name": "ScamShield AI — Quét vùng",
  "version": "0.9.0",
  "description": "Quét vùng; chế độ thử thu thập hội thoại và xuất file cục bộ, không gửi backend.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "worker.js"},
  "action": {"default_popup": "popup.html", "default_title": "ScamShield AI"},
  "minimum_chrome_version": "106"
}
