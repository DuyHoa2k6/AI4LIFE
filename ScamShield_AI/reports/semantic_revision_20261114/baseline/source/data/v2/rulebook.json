            "request"
          ],
          "temporal_states": [],
          "attribution_kinds": [],
          "requires_authentication_meaning": false
        },
        "state": {
          "event_types": [
            "receive_funds"
          ],
          "polarities": [
            "negative"
          ],
          "speech_roles": [
            "request",
