    {
      "rule_id": "R-HANDOVER",
      "version": "2.0",
      "scope": "same_scope_same_affected_party",
      "required_conditions": {
        "request": {
          "fact_types": [
            "handover_requested"
          ],
          "value": "TRUE",
          "speech_roles": [
            "request"
          ],
          "temporal_states": [],
          "attribution_kinds": [],
          "authentication_meaning": null
        },
        "state": {
          "fact_types": [
            "payment_confirmed"
          ],
          "value": "FALSE",
          "speech_roles": [
            "request",
            "claim",
            "reported"
          ],
          "temporal_states": [],
          "attribution_kinds": [],
          "authentication_meaning": null
        }
      },
      "required_relations": [
        {
          "type": "before",
          "from_fact": "request",
          "to_fact": "state"
        },
        {
          "type": "same_transaction",
          "from_fact": "request",
          "to_fact": "state"
        }
      ],
      "exclusion_conditions": [
        "later_payment_confirmed"
      ],
      "conclusion": "suspicious",
      "safety_urgency": "preventive",
      "evidence_requirements": "all_required_facts_and_relations",
      "missing_information": [
        "request",
        "state"
      ],
      "follow_up_template": null,
      "explanation_template": "TPL-R-HANDOVER",
      "supported_conclusion": "r-handover",
      "unknown_exclusion_policy": "limit_claim"
    },
