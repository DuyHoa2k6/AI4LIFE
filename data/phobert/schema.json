        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "participant_id": {
          "title": "Participant Id",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "role",
        "participant_id"
      ],
      "title": "Argument",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
